---
---
{%- comment -%}
  Minimalist single-line citation renderer.
  Format: Authors. Title. Venue, Year. (Award) link
  - author's own name bolded; title is plain text (NOT linked)
  - optional award shown in parentheses
  - a single hyperlink at the very end, with the literal anchor text "link"
  Spaces emitted via {{ " " }} so Liquid whitespace-trimming can't swallow them.
{%- endcomment -%}
{%- comment -%} Authors {%- endcomment -%}
<span class="minimal-authors">
{%- for author in entry.author_array -%}
  {%- assign a_last = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
  {%- assign is_self = false -%}
  {%- if site.scholar.last_name contains a_last and site.scholar.first_name contains author.first -%}
    {%- assign is_self = true -%}
  {%- endif -%}
  {%- if forloop.first == false -%}
    {%- if forloop.last -%}{{ " and " }}{%- else -%}{{ ", " }}{%- endif -%}
  {%- endif -%}
  {%- if is_self -%}<strong>{{ author.first }} {{ author.last }}</strong>{%- else -%}{{ author.first }} {{ author.last }}{%- endif -%}
{%- endfor -%}.</span>{{ " " }}
{%- comment -%} Title (plain, never a hyperlink) {%- endcomment -%}
<span class="minimal-title">{{ entry.title }}</span>.{{ " " }}
{%- comment -%} Venue + year {%- endcomment -%}
<span class="minimal-venue">
{%- if entry.type == 'article' -%}
  {%- if entry.journal and entry.journal != '' -%}
    <em>{{ entry.journal }}</em>
    {%- if entry.volume -%}{{ ", " }}{{ entry.volume }}{%- if entry.number -%}({{ entry.number }}){%- endif -%}{%- endif -%}
    {%- if entry.pages -%}{{ ", " }}{{ entry.pages }}{%- endif -%}{{ ", " }}{{ entry.year }}.
  {%- else -%}
    Preprint,{{ " " }}{{ entry.year }}.
  {%- endif -%}
{%- elsif entry.type == 'inproceedings' or entry.type == 'incollection' -%}
  <em>{{ entry.booktitle }}</em>{%- if entry.address -%}{{ ", " }}{{ entry.address }}{%- endif -%}{{ ", " }}{{ entry.year }}.
{%- else -%}
  {{ entry.year }}.
{%- endif -%}
</span>
{%- comment -%} Award (optional) {%- endcomment -%}
{%- if entry.award -%}{{ " " }}<span class="minimal-award">({{ entry.award }})</span>{%- endif -%}
{%- comment -%} Single link at the very end, anchor text literally "link" {%- endcomment -%}
{%- assign link = null -%}
{%- if entry.html -%}{%- assign link = entry.html -%}
{%- elsif entry.doi -%}{%- assign link = 'https://doi.org/' | append: entry.doi -%}
{%- elsif entry.medrxiv -%}{%- assign link = entry.medrxiv -%}
{%- elsif entry.ismrm -%}{%- assign link = entry.ismrm -%}
{%- endif -%}
{%- if link -%}{{ " " }}<a href="{{ link }}" class="minimal-link">link</a>{%- endif -%}
